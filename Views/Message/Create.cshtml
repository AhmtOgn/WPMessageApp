@model WPMessageApp.Models.Message 
@{
    ViewData["Title"] = "Yeni Mesaj Oluştur";
}

<h1>Yeni Mesaj Oluştur</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Örn: 905551234567" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="MessageText" class="control-label"></label>
                <textarea asp-for="MessageText" class="form-control" rows="5"></textarea>
                <span asp-validation-for="MessageText" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label class="control-label">Resim Yükle (Opsiyonel)</label>
                <input type="file" name="ImageFile" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Kaydet ve Gönderime Hazırla" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Listeye Geri Dön</a>
</div>